<!doctype html>
<html lang="es" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="{{ settings.bg | default: '#0C0C14' }}">
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;900&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet">
  <title>{{ page_title }}{%- if current_page != 1 %} — Página {{ current_page }}{% endif %}{%- unless page_title contains shop.name %} — {{ shop.name }}{% endunless %}</title>
  {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
  {{ content_for_header }}
  {{- 'theme.css' | asset_url | stylesheet_tag -}}
  <style>
    :root {
      --accent: {{ settings.accent | default: '#FF5A1F' }};
      --accent-hover: {{ settings.accent | default: '#FF5A1F' | color_modify: 'lightness', 12 }};
      --bg: {{ settings.bg | default: '#0C0C14' }};
    }
  </style>
  <script>
    window.CanvoyTheme = {
      moneyFormat: {{ shop.money_format | json }},
      freeShippingThreshold: {{ settings.free_shipping_threshold | default: 50 | times: 100 }},
      routes: {
        cart: {{ routes.cart_url | json }},
        checkout: '/checkout',
        allProducts: {{ routes.all_products_collection_url | json }}
      }
    };
  </script>
</head>
<body class="template-{{ template.name }}"><main id="MainContent" class="main-content" role="main" tabindex="-1">{{ content_for_layout }}</main></body>
</html>
