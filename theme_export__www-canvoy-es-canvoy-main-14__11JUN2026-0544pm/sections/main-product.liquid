{%- assign cv = product.selected_or_first_available_variant | default: product.variants.first -%}
{%- assign img = product.featured_image | default: nil -%}

<style>
.pdp-buybox {
  font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif;
  color: #111827;
  background: #fff;
}

.pdp-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
  max-width: 1200px;
  margin: 0 auto;
  padding: 48px 24px;
  align-items: start;
}

@media screen and (max-width: 749px) {
  .pdp-grid {
    grid-template-columns: 1fr;
    gap: 16px;
    padding: 16px;
  }
}

/* GALERIA */
.pdp-gallery {
  position: sticky;
  top: 24px;
}

@media screen and (max-width: 749px) {
  .pdp-gallery { position: static; }
}

.pdp-main-img {
  position: relative;
  border-radius: 12px;
  overflow: hidden;
  background: #f5f5f5;
  aspect-ratio: 1 / 1;
}

.pdp-main-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.pdp-img-badge {
  position: absolute;
  top: 12px;
  left: 12px;
  background: #FF5A1F;
  color: #fff;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  padding: 5px 10px;
  border-radius: 20px;
}

.pdp-thumbs {
  display: flex;
  gap: 8px;
  margin-top: 10px;
  flex-wrap: wrap;
}

@media screen and (max-width: 749px) {
  .pdp-thumbs { display: none; }
}

.pdp-thumb {
  width: 64px;
  height: 64px;
  border-radius: 8px;
  border: 2px solid transparent;
  cursor: pointer;
  padding: 0;
  background: none;
  overflow: hidden;
  transition: border-color 0.15s;
}

.pdp-thumb.active,
.pdp-thumb:hover {
  border-color: #FF5A1F;
}

.pdp-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* BUY BOX */
.pdp-info {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.pdp-label {
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: #FF5A1F;
}

.pdp-title {
  font-size: 26px;
  font-weight: 800;
  line-height: 1.2;
  color: #111827;
  margin: 0;
}

@media screen and (max-width: 749px) {
  .pdp-title { font-size: 22px; }
}

.pdp-sub {
  font-size: 14px;
  line-height: 1.55;
  color: #4B5563;
  margin: -6px 0 0;
}

.pdp-rating {
  font-size: 13px;
  color: #374151;
  display: flex;
  align-items: center;
  gap: 6px;
}

.pdp-stars { color: #F59E0B; }

.pdp-price {
  display: flex;
  align-items: baseline;
  gap: 10px;
  flex-wrap: wrap;
}

.pdp-price__cur {
  font-size: 28px;
  font-weight: 800;
  color: #111827;
}

@media screen and (max-width: 749px) {
  .pdp-price__cur { font-size: 24px; }
}

.pdp-price__old {
  font-size: 16px;
  color: #9CA3AF;
  text-decoration: line-through;
}

.pdp-price__save {
  background: #DCFCE7;
  color: #16A34A;
  font-size: 12px;
  font-weight: 700;
  padding: 3px 8px;
  border-radius: 20px;
}

/* BULLETS */
.pdp-bullets {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.pdp-bullet {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  color: #374151;
}

.pdp-bullet::before {
  content: "\2713";
  color: #FF5A1F;
  font-weight: 700;
  font-size: 12px;
  flex-shrink: 0;
}

/* BUNDLES */
.pdp-bundles-heading {
  font-size: 13px;
  font-weight: 700;
  color: #111827;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  margin: 0;
}

.pdp-bundles {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.pdp-bundle {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 14px;
  border: 2px solid #E5E7EB;
  border-radius: 10px;
  cursor: pointer;
  background: #fff;
  text-align: left;
  transition: border-color 0.15s, background 0.15s;
  position: relative;
  width: 100%;
}

.pdp-bundle.active {
  border-color: #FF5A1F;
  background: #FFF8F5;
}

.pdp-bundle input[type="radio"] {
  accent-color: #FF5A1F;
  width: 16px;
  height: 16px;
  flex-shrink: 0;
}

.pdp-bundle__body {
  flex: 1;
  min-width: 0;
}

.pdp-bundle__title {
  font-size: 13px;
  font-weight: 700;
  color: #111827;
}

.pdp-bundle__saving {
  font-size: 12px;
  color: #16A34A;
  font-weight: 600;
}

.pdp-bundle__prices {
  display: flex;
  align-items: baseline;
  gap: 6px;
  margin-top: 2px;
  flex-wrap: wrap;
}

.pdp-bundle__price {
  font-size: 15px;
  font-weight: 800;
  color: #111827;
}

.pdp-bundle__compare {
  font-size: 12px;
  color: #9CA3AF;
  text-decoration: line-through;
}

.pdp-bundle__unit {
  font-size: 11px;
  color: #6B7280;
}

.pdp-bundle__badge {
  font-size: 11px;
  font-weight: 700;
  background: #FF5A1F;
  color: #fff;
  padding: 2px 8px;
  border-radius: 20px;
  white-space: nowrap;
  flex-shrink: 0;
}

/* CTA */
.pdp-cta {
  width: 100%;
  height: 52px;
  background: #FF5A1F;
  color: #fff;
  border: none;
  border-radius: 10px;
  font-size: 16px;
  font-weight: 700;
  cursor: pointer;
  transition: background 0.15s, transform 0.1s;
  letter-spacing: 0.01em;
}

.pdp-cta:hover { background: #E54D1B; }
.pdp-cta:active { transform: scale(0.98); }
.pdp-cta:disabled { background: #D1D5DB; cursor: not-allowed; }

/* TRUST */
.pdp-trust {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  padding-top: 2px;
}

.pdp-trust-item {
  font-size: 11px;
  color: #6B7280;
  display: flex;
  align-items: center;
  gap: 4px;
}

/* INFO TABS */
.pdp-info-tabs {
  border-top: 1px solid #F3F4F6;
  padding-top: 12px;
  display: flex;
  flex-direction: column;
  gap: 0;
}

.pdp-info-tab {
  border-bottom: 1px solid #F3F4F6;
}

.pdp-info-tab summary {
  padding: 10px 0;
  font-size: 13px;
  font-weight: 600;
  color: #374151;
  cursor: pointer;
  list-style: none;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.pdp-info-tab summary::after {
  content: "+";
  font-size: 16px;
  color: #9CA3AF;
}

.pdp-info-tab[open] summary::after {
  content: "-";
}

.pdp-info-tab__body {
  font-size: 13px;
  color: #4B5563;
  line-height: 1.6;
  padding-bottom: 12px;
}
</style>

<div class="pdp-buybox">
  <div class="pdp-grid">

    <!-- GALERIA -->
    <div class="pdp-gallery">
      <div class="pdp-main-img">
        {%- if img -%}
          <img src="{{ img | image_url: width: 900 }}" alt="{{ product.title | escape }}" id="pdp-main-img" width="900" height="900" loading="eager">
        {%- else -%}
          <div style="width:100%;aspect-ratio:1/1;background:#eee;display:flex;align-items:center;justify-content:center;color:#aaa;font-size:13px">Sin imagen</div>
        {%- endif -%}
        {%- if cv.compare_at_price > cv.price -%}
          <span class="pdp-img-badge">Ahorra {{ cv.compare_at_price | minus: cv.price | money }}</span>
        {%- endif -%}
      </div>
      {%- if product.media.size > 1 -%}
        <div class="pdp-thumbs">
          {%- for media in product.media limit: 5 -%}
            <button class="pdp-thumb{% if forloop.first %} active{% endif %}" data-src="{{ media | image_url: width: 900 }}" aria-label="Imagen {{ forloop.index }}">
              <img src="{{ media | image_url: width: 120 }}" alt="" loading="lazy" width="120" height="120">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <!-- BUY BOX -->
    <div class="pdp-info">

      <span class="pdp-label">{{ product.type | default: product.vendor }}</span>

      <h1 class="pdp-title">{{ product.title }}</h1>

      {%- if section.settings.subtitle != blank -%}
        <p class="pdp-sub">{{ section.settings.subtitle }}</p>
      {%- endif -%}

      {%- if section.settings.review_count_text != blank -%}
        <div class="pdp-rating">
          <span class="pdp-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
          <span>{{ section.settings.review_count_text }}</span>
        </div>
      {%- endif -%}

      <div class="pdp-price">
        <span class="pdp-price__cur">{{ cv.price | money }}</span>
        {%- if cv.compare_at_price > cv.price -%}
          <span class="pdp-price__old">{{ cv.compare_at_price | money }}</span>
          <span class="pdp-price__save">-{{ cv.compare_at_price | minus: cv.price | times: 100 | divided_by: cv.compare_at_price | round }}%</span>
        {%- endif -%}
      </div>

      {%- assign has_bullets = false -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'bullet' -%}{%- assign has_bullets = true -%}{%- endif -%}
      {%- endfor -%}
      {%- if has_bullets -%}
        <ul class="pdp-bullets">
          {%- for block in section.blocks -%}
            {%- if block.type == 'bullet' -%}
              <li class="pdp-bullet" {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- assign has_bundles = false -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'bundle' -%}{%- assign has_bundles = true -%}{%- endif -%}
      {%- endfor -%}

      {%- if has_bundles -%}
        {%- if section.settings.bundle_heading != blank -%}
          <p class="pdp-bundles-heading">{{ section.settings.bundle_heading }}</p>
        {%- endif -%}
        <div class="pdp-bundles">
          {%- assign bundle_index = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'bundle' -%}
              {%- assign is_first = false -%}
              {%- if bundle_index == 0 -%}{%- assign is_first = true -%}{%- endif -%}
              <label class="pdp-bundle{% if is_first %} active{% endif %}" {{ block.shopify_attributes }}>
                <input type="radio" name="pdp-bundle" value="{{ block.settings.qty }}"
                  data-qty="{{ block.settings.qty }}"
                  {% if is_first %}checked{% endif %}>
                <div class="pdp-bundle__body">
                  <div class="pdp-bundle__title">{{ block.settings.title }}</div>
                  {%- if block.settings.saving_text != blank -%}
                    <div class="pdp-bundle__saving">{{ block.settings.saving_text }}</div>
                  {%- endif -%}
                  <div class="pdp-bundle__prices">
                    <span class="pdp-bundle__price">{{ block.settings.price }}</span>
                    {%- if block.settings.compare_price != blank -%}
                      <span class="pdp-bundle__compare">{{ block.settings.compare_price }}</span>
                    {%- endif -%}
                    {%- if block.settings.unit_label != blank -%}
                      <span class="pdp-bundle__unit">{{ block.settings.unit_label }}</span>
                    {%- endif -%}
                  </div>
                </div>
                {%- if block.settings.badge_text != blank -%}
                  <span class="pdp-bundle__badge">{{ block.settings.badge_text }}</span>
                {%- endif -%}
              </label>
              {%- assign bundle_index = bundle_index | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      <button class="pdp-cta" id="pdp-atc" data-variant-id="{{ cv.id }}" {% unless cv.available %}disabled{% endunless %}>
        {%- if cv.available -%}Anadir al carrito{%- else -%}Agotado{%- endif -%}
      </button>

      <div class="pdp-trust">
        <span class="pdp-trust-item">&#128666; Envio Espana</span>
        <span class="pdp-trust-item">&#128274; Pago seguro</span>
        <span class="pdp-trust-item">&#128737; 30 dias garantia</span>
        <span class="pdp-trust-item">&#128230; Devolucion gratis</span>
      </div>

      {%- if section.settings.shipping_text != blank or section.settings.returns_text != blank -%}
        <div class="pdp-info-tabs">
          {%- if section.settings.shipping_text != blank -%}
            <details class="pdp-info-tab">
              <summary>Envio y entrega</summary>
              <div class="pdp-info-tab__body">{{ section.settings.shipping_text }}</div>
            </details>
          {%- endif -%}
          {%- if section.settings.returns_text != blank -%}
            <details class="pdp-info-tab">
              <summary>Devoluciones</summary>
              <div class="pdp-info-tab__body">{{ section.settings.returns_text }}</div>
            </details>
          {%- endif -%}
        </div>
      {%- endif -%}

    </div>
  </div>
</div>

<script>
(function () {
  document.querySelectorAll('.pdp-thumb').forEach(function (btn) {
    btn.addEventListener('click', function () {
      document.querySelectorAll('.pdp-thumb').forEach(function (b) { b.classList.remove('active'); });
      btn.classList.add('active');
      var img = document.getElementById('pdp-main-img');
      if (img && btn.dataset.src) img.src = btn.dataset.src;
    });
  });

  document.querySelectorAll('.pdp-bundle input[type="radio"]').forEach(function (radio) {
    radio.addEventListener('change', function () {
      document.querySelectorAll('.pdp-bundle').forEach(function (b) { b.classList.remove('active'); });
      radio.closest('.pdp-bundle').classList.add('active');
    });
  });

  var atcBtn = document.getElementById('pdp-atc');
  if (atcBtn) {
    atcBtn.addEventListener('click', function () {
      var btn = this;
      var selectedRadio = document.querySelector('.pdp-bundle input[type="radio"]:checked');
      var qty = selectedRadio ? parseInt(selectedRadio.dataset.qty, 10) : 1;
      var variantId = parseInt(btn.dataset.variantId, 10);
      btn.textContent = 'Anadiendo...';
      btn.disabled = true;
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: variantId, quantity: qty })
      })
        .then(function () {
          btn.textContent = 'Anadido al carrito';
          document.dispatchEvent(new CustomEvent('cart:updated'));
          setTimeout(function () {
            btn.textContent = 'Anadir al carrito';
            btn.disabled = false;
          }, 2000);
        })
        .catch(function () {
          btn.textContent = 'Error - reintentar';
          btn.disabled = false;
        });
    });
  }
})();
</script>

{% schema %}
{
  "name": "PDP BuyBox",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitulo",
      "default": "Hidratacion y comida, listas en segundos."
    },
    {
      "type": "text",
      "id": "review_count_text",
      "label": "Texto de resenas",
      "default": "4.9 - 127 resenas"
    },
    {
      "type": "text",
      "id": "bundle_heading",
      "label": "Titulo seccion bundles",
      "default": "COMPRA UN PACK Y AHORRA"
    },
    {
      "type": "textarea",
      "id": "shipping_text",
      "label": "Texto envio",
      "default": "Envio a toda Espana en 3-5 dias habiles. Envio gratuito en pedidos +50EUR."
    },
    {
      "type": "textarea",
      "id": "returns_text",
      "label": "Texto devoluciones",
      "default": "Tienes 30 dias para probarlo. Si no es lo que esperabas, reembolso en 48h sin preguntas."
    }
  ],
  "blocks": [
    {
      "type": "bullet",
      "name": "Bullet beneficio",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texto del bullet",
          "default": "Beneficio clave del producto"
        }
      ]
    },
    {
      "type": "bundle",
      "name": "Opcion de pack",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Nombre del pack",
          "default": "CANVOY Pack 1"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Precio",
          "default": "22,95EUR"
        },
        {
          "type": "text",
          "id": "compare_price",
          "label": "Precio tachado (dejar vacio si no aplica)"
        },
        {
          "type": "text",
          "id": "saving_text",
          "label": "Texto ahorro"
        },
        {
          "type": "text",
          "id": "unit_label",
          "label": "Precio por unidad",
          "default": "22,95EUR / ud"
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge (dejar vacio si no aplica)"
        },
        {
          "type": "number",
          "id": "qty",
          "label": "Cantidad a anadir al carrito",
          "default": 1
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PDP BuyBox"
    }
  ]
}
{% endschema %}
