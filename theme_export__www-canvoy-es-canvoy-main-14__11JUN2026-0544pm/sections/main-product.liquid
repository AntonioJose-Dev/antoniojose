{%- comment -%}
  main-product.liquid — shell orquestador (Fase 6A)
  Carga CSS de variantes + snippet product-variants
{%- endcomment -%}

{{ 'pdp-buybox.css'   | asset_url | stylesheet_tag }}
{{ 'pdp-variants.css' | asset_url | stylesheet_tag }}

{%- assign cv = product.selected_or_first_available_variant | default: product.variants.first -%}

{%- comment -%} Pre-seleccionar bundle con badge_text {%- endcomment -%}
{%- assign default_bundle_index = 0 -%}
{%- assign bundle_scan = 0 -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'bundle' -%}
    {%- if block.settings.badge_text != blank and default_bundle_index == 0 -%}
      {%- assign default_bundle_index = bundle_scan -%}
    {%- endif -%}
    {%- assign bundle_scan = bundle_scan | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}

<div class="pdp-buybox">
  <div class="pdp-grid">
    {%- render 'product-media', product: product, cv: cv -%}

    <div class="pdp-info">

      <span class="pdp-label">{{ product.type | default: product.vendor }}</span>
      <h1 class="pdp-title">{{ product.title }}</h1>

      {%- if section.settings.subtitle != blank -%}
        <p class="pdp-sub">{{ section.settings.subtitle }}</p>
      {%- endif -%}

      {%- if section.settings.review_count_text != blank -%}
        <div class="pdp-rating">
          <span class="pdp-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
          <span>{{ section.settings.review_count_text }}</span>
        </div>
      {%- endif -%}

      <div class="pdp-price">
        <span class="pdp-price__cur">{{ cv.price | money }}</span>
        {%- if cv.compare_at_price > cv.price -%}
          <span class="pdp-price__old">{{ cv.compare_at_price | money }}</span>
          <span class="pdp-price__save">
            -{{ cv.compare_at_price | minus: cv.price | times: 100 | divided_by: cv.compare_at_price | round }}%
          </span>
        {%- endif -%}
      </div>

      {%- comment -%} ★ NUEVO: selector de variantes (Fase 6A) {%- endcomment -%}
      {%- render 'product-variants', product: product, cv: cv -%}

      {%- render 'product-meta-bullets', product: product, section: section -%}

      {%- render 'product-bundles', section: section, default_bundle_index: default_bundle_index -%}

      {%- if section.settings.urgency_text != blank -%}
        <div class="pdp-urgency">
          <span class="pdp-urgency__icon">&#9889;</span>
          <span>{{ section.settings.urgency_text }}</span>
        </div>
      {%- endif -%}

      <button
        class="pdp-cta"
        id="pdp-atc"
        data-variant-id="{{ cv.id }}"
        {%- unless cv.available -%} disabled{%- endunless -%}
      >
        {%- if cv.available -%}A&ntilde;adir al carrito{%- else -%}Agotado{%- endif -%}
      </button>

      <div class="pdp-trust">
        <span class="pdp-trust-item">&#128666; Env&iacute;o Espa&ntilde;a</span>
        <span class="pdp-trust-item">&#128274; Pago seguro</span>
        <span class="pdp-trust-item">&#128737; 30 d&iacute;as garant&iacute;a</span>
        <span class="pdp-trust-item">&#128230; Devoluci&oacute;n gratis</span>
      </div>

      {%- if section.settings.shipping_text != blank or section.settings.returns_text != blank -%}
        <div class="pdp-info-tabs">
          {%- if section.settings.shipping_text != blank -%}
            <details class="pdp-info-tab">
              <summary>Env&iacute;o y entrega</summary>
              <div class="pdp-info-tab__body">{{ section.settings.shipping_text }}</div>
            </details>
          {%- endif -%}
          {%- if section.settings.returns_text != blank -%}
            <details class="pdp-info-tab">
              <summary>Devoluciones</summary>
              <div class="pdp-info-tab__body">{{ section.settings.returns_text }}</div>
            </details>
          {%- endif -%}
        </div>
      {%- endif -%}

    </div>
  </div>
</div>

{%- render 'product-sticky-atc', product: product, cv: cv -%}

<script src="{{ 'pdp-variants.js' | asset_url }}" defer></script>

<script>
(function () {

  /* --- Galería thumbs --- */
  document.querySelectorAll('.pdp-thumb').forEach(function (btn) {
    btn.addEventListener('click', function () {
      document.querySelectorAll('.pdp-thumb').forEach(function (b) { b.classList.remove('active'); });
      btn.classList.add('active');
      var img = document.getElementById('pdp-main-img');
      if (img && btn.dataset.src) img.src = btn.dataset.src;
    });
  });

  /* --- Bundles: selección y sincronización con sticky --- */
  var stickyPrice = document.getElementById('pdp-sticky-price');
  var stickyName  = document.getElementById('pdp-sticky-name');

  function syncSticky() {
    var checked = document.querySelector('.pdp-bundle input[type="radio"]:checked');
    if (!checked) return;
    if (stickyPrice) stickyPrice.textContent = checked.dataset.price || '';
    if (stickyName)  stickyName.textContent  = checked.dataset.title || document.title;
  }

  document.querySelectorAll('.pdp-bundle input[type="radio"]').forEach(function (radio) {
    radio.addEventListener('change', function () {
      document.querySelectorAll('.pdp-bundle').forEach(function (b) { b.classList.remove('active'); });
      radio.closest('.pdp-bundle').classList.add('active');
      syncSticky();
    });
  });

  syncSticky();

  /* --- Ocultar sticky cuando el ATC principal es visible --- */
  var mainAtc   = document.getElementById('pdp-atc');
  var stickyBar = document.getElementById('pdp-sticky-atc');

  if (mainAtc && stickyBar && 'IntersectionObserver' in window) {
    var obs = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        stickyBar.style.display = e.isIntersecting ? 'none' : 'block';
        stickyBar.setAttribute('aria-hidden', e.isIntersecting ? 'true' : 'false');
      });
    }, { threshold: 0.1 });
    obs.observe(mainAtc);
  }

  /* --- Añadir al carrito --- */
  function addToCart(btn, originalText) {
    var selectedRadio = document.querySelector('.pdp-bundle input[type="radio"]:checked');
    var qty       = selectedRadio ? parseInt(selectedRadio.dataset.qty, 10) : 1;
    var varInput  = document.getElementById('pdp-variant-id');
    var variantId = varInput
      ? parseInt(varInput.value, 10)
      : parseInt(btn.dataset.variantId, 10);

    btn.textContent = 'Añadiendo\u2026';
    btn.disabled = true;

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: variantId, quantity: qty })
    })
      .then(function () {
        btn.textContent = '\u2713 Añadido';
        document.dispatchEvent(new CustomEvent('cart:updated'));
        setTimeout(function () {
          btn.textContent = originalText;
          btn.disabled = false;
        }, 2000);
      })
      .catch(function () {
        btn.textContent = 'Error \u2014 reintentar';
        btn.disabled = false;
      });
  }

  var mainAtcBtn = document.getElementById('pdp-atc');
  if (mainAtcBtn) {
    var mainOriginal = mainAtcBtn.textContent.trim();
    mainAtcBtn.addEventListener('click', function () { addToCart(mainAtcBtn, mainOriginal); });
  }

  var stickyBtn = document.getElementById('pdp-sticky-btn');
  if (stickyBtn) {
    var stickyOriginal = stickyBtn.textContent.trim();
    stickyBtn.addEventListener('click', function () { addToCart(stickyBtn, stickyOriginal); });
  }

})();
</script>

{% schema %}
{
  "name": "PDP BuyBox",
  "settings": [
    { "type": "text",    "id": "subtitle",          "label": "Subtítulo",              "default": "Hidratación y comida, listas en segundos." },
    { "type": "text",    "id": "review_count_text",  "label": "Texto de reseñas",       "default": "4.9 · 127 reseñas" },
    { "type": "text",    "id": "bundle_heading",     "label": "Título sección bundles", "default": "COMPRA UN PACK Y AHORRA" },
    { "type": "text",    "id": "urgency_text",       "label": "Texto de urgencia",      "default": "" },
    { "type": "textarea","id": "shipping_text",      "label": "Texto envío",            "default": "Envío a toda España en 3–5 días hábiles. Envío gratuito en pedidos +50€." },
    { "type": "textarea","id": "returns_text",       "label": "Texto devoluciones",    "default": "Tienes 30 días para probarlo. Reembolso en 48h sin preguntas." }
  ],
  "blocks": [
    {
      "type": "bullet",
      "name": "Bullet beneficio",
      "settings": [
        { "type": "text", "id": "text", "label": "Texto del bullet", "default": "Beneficio clave del producto" }
      ]
    },
    {
      "type": "bundle",
      "name": "Opción de pack",
      "settings": [
        { "type": "text",   "id": "title",        "label": "Nombre del pack",      "default": "Pack 1 unidad" },
        { "type": "text",   "id": "price",        "label": "Precio",               "default": "22,95€" },
        { "type": "text",   "id": "compare_price","label": "Precio tachado" },
        { "type": "text",   "id": "saving_text",  "label": "Texto ahorro" },
        { "type": "text",   "id": "unit_label",   "label": "Precio por unidad",    "default": "22,95€ / ud" },
        { "type": "text",   "id": "badge_text",   "label": "Badge (vacío si no aplica)", "info": "El primer bundle con badge se pre-selecciona automáticamente" },
        { "type": "number", "id": "qty",          "label": "Cantidad",             "default": 1 }
      ]
    }
  ],
  "presets": [{ "name": "PDP BuyBox" }]
}
{% endschema %}
