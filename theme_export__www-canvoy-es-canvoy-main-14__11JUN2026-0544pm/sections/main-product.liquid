{%- comment -%}
  main-product.liquid — shell orquestador
  Calcula variables globales y delega el renderizado a snippets.
  NO contiene HTML de presentación directa.
{%- endcomment -%}

{%- assign cv = product.selected_or_first_available_variant | default: product.variants.first -%}

{%- comment -%} Pre-seleccionar el bundle con badge_text {%- endcomment -%}
{%- assign default_bundle_index = 0 -%}
{%- assign bundle_scan = 0 -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'bundle' -%}
    {%- if block.settings.badge_text != blank and default_bundle_index == 0 -%}
      {%- assign default_bundle_index = bundle_scan -%}
    {%- endif -%}
    {%- assign bundle_scan = bundle_scan | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}

<div class="pdp-buybox">
  <div class="pdp-grid">
    {%- render 'product-media', product: product, cv: cv -%}
    {%- render 'product-buy-box', product: product, cv: cv, section: section, default_bundle_index: default_bundle_index -%}
  </div>
</div>

{%- render 'product-sticky-atc', product: product, cv: cv -%}

<script>
(function () {

  /* --- Galería thumbs --- */
  document.querySelectorAll('.pdp-thumb').forEach(function (btn) {
    btn.addEventListener('click', function () {
      document.querySelectorAll('.pdp-thumb').forEach(function (b) { b.classList.remove('active'); });
      btn.classList.add('active');
      var img = document.getElementById('pdp-main-img');
      if (img && btn.dataset.src) img.src = btn.dataset.src;
    });
  });

  /* --- Bundles: selección y sincronización con sticky --- */
  var stickyPrice = document.getElementById('pdp-sticky-price');
  var stickyName  = document.getElementById('pdp-sticky-name');

  function syncSticky() {
    var checked = document.querySelector('.pdp-bundle input[type="radio"]:checked');
    if (!checked) return;
    if (stickyPrice) stickyPrice.textContent = checked.dataset.price || '';
    if (stickyName)  stickyName.textContent  = checked.dataset.title || document.title;
  }

  document.querySelectorAll('.pdp-bundle input[type="radio"]').forEach(function (radio) {
    radio.addEventListener('change', function () {
      document.querySelectorAll('.pdp-bundle').forEach(function (b) { b.classList.remove('active'); });
      radio.closest('.pdp-bundle').classList.add('active');
      syncSticky();
    });
  });

  syncSticky();

  /* --- Ocultar sticky cuando el ATC principal es visible --- */
  var mainAtc   = document.getElementById('pdp-atc');
  var stickyBar = document.getElementById('pdp-sticky-atc');

  if (mainAtc && stickyBar && 'IntersectionObserver' in window) {
    var obs = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        stickyBar.style.display = e.isIntersecting ? 'none' : 'block';
        stickyBar.setAttribute('aria-hidden', e.isIntersecting ? 'true' : 'false');
      });
    }, { threshold: 0.1 });
    obs.observe(mainAtc);
  }

  /* --- Añadir al carrito --- */
  function addToCart(btn, originalText) {
    var selectedRadio = document.querySelector('.pdp-bundle input[type="radio"]:checked');
    var qty = selectedRadio ? parseInt(selectedRadio.dataset.qty, 10) : 1;
    var variantId = parseInt(btn.dataset.variantId, 10);

    btn.textContent = 'A\u00F1adiendo\u2026';
    btn.disabled = true;

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: variantId, quantity: qty })
    })
      .then(function () {
        btn.textContent = '\u2713 A\u00F1adido';
        document.dispatchEvent(new CustomEvent('cart:updated'));
        setTimeout(function () {
          btn.textContent = originalText;
          btn.disabled = false;
        }, 2000);
      })
      .catch(function () {
        btn.textContent = 'Error \u2014 reintentar';
        btn.disabled = false;
      });
  }

  var mainAtcBtn = document.getElementById('pdp-atc');
  if (mainAtcBtn) {
    var mainOriginal = mainAtcBtn.textContent.trim();
    mainAtcBtn.addEventListener('click', function () { addToCart(mainAtcBtn, mainOriginal); });
  }

  var stickyBtn = document.getElementById('pdp-sticky-btn');
  if (stickyBtn) {
    var stickyOriginal = stickyBtn.textContent.trim();
    stickyBtn.addEventListener('click', function () { addToCart(stickyBtn, stickyOriginal); });
  }

})();
</script>

{% schema %}
{
  "name": "PDP BuyBox",
  "settings": [
    { "type": "text", "id": "subtitle", "label": "Subt\u00edtulo", "default": "Hidrataci\u00f3n y comida, listas en segundos." },
    { "type": "text", "id": "review_count_text", "label": "Texto de rese\u00f1as", "default": "4.9 \u00b7 127 rese\u00f1as" },
    { "type": "text", "id": "bundle_heading", "label": "T\u00edtulo secci\u00f3n bundles", "default": "COMPRA UN PACK Y AHORRA" },
    { "type": "text", "id": "urgency_text", "label": "Texto de urgencia (vac\u00edo para ocultar)", "default": "" },
    { "type": "textarea", "id": "shipping_text", "label": "Texto env\u00edo", "default": "Env\u00edo a toda Espa\u00f1a en 3\u20135 d\u00edas h\u00e1biles. Env\u00edo gratuito en pedidos +50\u20ac." },
    { "type": "textarea", "id": "returns_text", "label": "Texto devoluciones", "default": "Tienes 30 d\u00edas para probarlo. Reembolso en 48h sin preguntas." }
  ],
  "blocks": [
    {
      "type": "bullet",
      "name": "Bullet beneficio",
      "settings": [
        { "type": "text", "id": "text", "label": "Texto del bullet", "default": "Beneficio clave del producto" }
      ]
    },
    {
      "type": "bundle",
      "name": "Opci\u00f3n de pack",
      "settings": [
        { "type": "text", "id": "title", "label": "Nombre del pack", "default": "Pack 1 unidad" },
        { "type": "text", "id": "price", "label": "Precio", "default": "22,95\u20ac" },
        { "type": "text", "id": "compare_price", "label": "Precio tachado" },
        { "type": "text", "id": "saving_text", "label": "Texto ahorro" },
        { "type": "text", "id": "unit_label", "label": "Precio por unidad", "default": "22,95\u20ac / ud" },
        { "type": "text", "id": "badge_text", "label": "Badge (vac\u00edo si no aplica)", "info": "El primer bundle con badge se pre-selecciona autom\u00e1ticamente" },
        { "type": "number", "id": "qty", "label": "Cantidad a a\u00f1adir al carrito", "default": 1 }
      ]
    }
  ],
  "presets": [{ "name": "PDP BuyBox" }]
}
{% endschema %}
