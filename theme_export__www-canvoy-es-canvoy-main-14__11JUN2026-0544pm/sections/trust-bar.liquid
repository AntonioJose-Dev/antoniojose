<style>
.trust-bar {
  background: #111827;
  padding: 14px 24px;
}
.trust-bar__inner {
  max-width: 1100px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32px;
  flex-wrap: wrap;
}
.trust-bar__item {
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: 12px;
  font-weight: 600;
  color: #F9FAFB;
  white-space: nowrap;
}
.trust-bar__icon { font-size: 15px; }
@media(max-width:580px){
  .trust-bar__inner { gap: 16px; }
  .trust-bar__item { font-size: 11px; }
}
</style>

<div class="trust-bar" id="trust-bar-{{ section.id }}">
  <div class="trust-bar__inner">
    {%- for block in section.blocks -%}
      {%- if block.type == 'item' -%}
        <div class="trust-bar__item" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != blank -%}
            <span class="trust-bar__icon">{{ block.settings.icon }}</span>
          {%- endif -%}
          <span>{{ block.settings.text }}</span>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Trust Bar",
  "blocks": [
    {
      "type": "item",
      "name": "Item de confianza",
      "settings": [
        { "type": "text", "id": "icon", "label": "Emoji / icono", "default": "🚚" },
        { "type": "text", "id": "text", "label": "Texto", "default": "" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Bar",
      "blocks": [
        { "type": "item", "settings": { "icon": "🚚", "text": "Envío gratis +50€" } },
        { "type": "item", "settings": { "icon": "🔒", "text": "Pago 100% seguro" } },
        { "type": "item", "settings": { "icon": "↺", "text": "30 días de devolución" } },
        { "type": "item", "settings": { "icon": "⭐", "text": "4.9 · +500 reseñas" } }
      ]
    }
  ]
}
{% endschema %}
