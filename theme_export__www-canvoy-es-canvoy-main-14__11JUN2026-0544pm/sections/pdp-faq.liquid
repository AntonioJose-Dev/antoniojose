{%- comment -%}
  pdp-faq.liquid
  Sección: FAQ en acordeón
  Estructura: heading + lista de <details> animados
{%- endcomment -%}

{{ 'pdp-content.css' | asset_url | stylesheet_tag }}

<section class="pdp-sec pdp-faq" id="pdp-faq">
  <div class="pdp-sec__inner pdp-sec__inner--narrow">

    <div class="pdp-sec__header">
      {%- if section.settings.eyebrow != blank -%}
        <span class="pdp-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="pdp-sec__title">{{ section.settings.heading }}</h2>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="pdp-faq__list">
        {%- for block in section.blocks -%}
          <details class="pdp-faq__item" {{ block.shopify_attributes }}>
            <summary class="pdp-faq__question">
              {{ block.settings.question }}
              <span class="pdp-faq__icon" aria-hidden="true"></span>
            </summary>
            <div class="pdp-faq__answer">
              {{ block.settings.answer }}
            </div>
          </details>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "PDP FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Preguntas frecuentes" },
    { "type": "text", "id": "heading", "label": "Título",  "default": "Todo lo que necesitas saber" }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Pregunta",
      "settings": [
        { "type": "text",     "id": "question", "label": "Pregunta", "default": "¿Cuánto tarda en llegar el pedido?" },
        { "type": "richtext","id": "answer",   "label": "Respuesta", "default": "<p>Enviamos a toda España en 3–5 días hábiles. Los pedidos realizados antes de las 14:00h salen el mismo día.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "PDP FAQ" }]
}
{% endschema %}
