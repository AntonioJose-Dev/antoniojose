{%- assign claim = product.metafields.custom.claim.value -%}
{%- assign bullets = product.metafields.custom.bullets.value -%}

<section class="section lp-hero" style="background: {{ section.settings.bg_color }};">
  <div class="wrap lp-hero__inner">

    <div class="lp-hero__media">
      {%- if section.settings.hero_image -%}
        <img
          src="{{ section.settings.hero_image | image_url: width: 800 }}"
          alt="{{ section.settings.hero_image.alt | escape }}"
          width="800"
          height="800"
          loading="eager"
          class="lp-hero__img"
        >
      {%- elsif product.featured_image -%}
        <img
          src="{{ product.featured_image | image_url: width: 800 }}"
          alt="{{ product.featured_image.alt | escape }}"
          width="800"
          height="800"
          loading="eager"
          class="lp-hero__img"
        >
      {%- endif -%}
    </div>

    <div class="lp-hero__content">

      {%- if section.settings.eyebrow != blank -%}
        <p class="lp-hero__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      <h1 class="lp-hero__title">
        {%- if section.settings.hero_title != blank -%}
          {{ section.settings.hero_title }}
        {%- elsif claim != blank -%}
          {{ claim }}
        {%- else -%}
          {{ product.title }}
        {%- endif -%}
      </h1>

      {%- if section.settings.hero_subtitle != blank -%}
        <p class="lp-hero__subtitle">{{ section.settings.hero_subtitle }}</p>
      {%- endif -%}

      {%- comment -%} Bullets — metafield primero, fallback a blocks {%- endcomment -%}
      {%- if bullets != blank -%}
        <ul class="lp-hero__bullets">
          {%- for bullet in bullets -%}
            <li>✓ {{ bullet }}</li>
          {%- endfor -%}
        </ul>
      {%- elsif section.blocks.size > 0 -%}
        <ul class="lp-hero__bullets">
          {%- for block in section.blocks -%}
            {%- if block.type == 'bullet' -%}
              <li {{ block.shopify_attributes }}>✓ {{ block.settings.text }}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- comment -%} Precio + ATC {%- endcomment -%}
      <div class="lp-hero__buy-box">
        {%- form 'product', product, id: 'lp-hero-form' -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

          <div class="lp-hero__price">
            {%- if product.compare_at_price > product.price -%}
              <span class="price-compare">{{ product.compare_at_price | money }}</span>
            {%- endif -%}
            <span class="price-current">{{ product.price | money }}</span>
            {%- if product.compare_at_price > product.price -%}
              {%- assign discount = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
              <span class="price-badge">-{{ discount }}%</span>
            {%- endif -%}
          </div>

          <button type="submit" name="add" class="btn btn--primary btn--full lp-hero__atc"
            {%- unless product.selected_or_first_available_variant.available -%} disabled{%- endunless -%}>
            {%- if product.selected_or_first_available_variant.available -%}
              {{ section.settings.atc_label | default: 'Añadir al carrito' }}
            {%- else -%}
              Agotado
            {%- endif -%}
          </button>
        {%- endform -%}

        {%- if section.settings.subtext != blank -%}
          <p class="lp-hero__subtext">{{ section.settings.subtext }}</p>
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

<style>
  .lp-hero__inner { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center; }
  .lp-hero__img { width: 100%; border-radius: 12px; }
  .lp-hero__eyebrow { font-size: 0.85rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; opacity: 0.6; margin-bottom: 0.5rem; }
  .lp-hero__title { font-size: clamp(1.8rem, 3vw, 2.8rem); line-height: 1.15; font-weight: 800; margin-bottom: 0.75rem; }
  .lp-hero__subtitle { font-size: 1.1rem; opacity: 0.75; margin-bottom: 1.25rem; }
  .lp-hero__bullets { list-style: none; padding: 0; margin-bottom: 1.5rem; display: flex; flex-direction: column; gap: 0.4rem; }
  .lp-hero__bullets li { font-size: 0.95rem; font-weight: 500; }
  .lp-hero__price { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem; }
  .price-compare { text-decoration: line-through; opacity: 0.45; font-size: 1rem; }
  .price-current { font-size: 1.6rem; font-weight: 800; }
  .price-badge { background: #e74c3c; color: #fff; font-size: 0.8rem; font-weight: 700; padding: 0.2rem 0.5rem; border-radius: 4px; }
  .lp-hero__atc { margin-bottom: 0.75rem; }
  .lp-hero__subtext { font-size: 0.8rem; text-align: center; opacity: 0.55; }
  @media (max-width: 768px) { .lp-hero__inner { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "LP Hero producto",
  "tag": "section",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Color de fondo", "default": "#ffffff" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (sobre el título)", "default": "" },
    { "type": "textarea", "id": "hero_title", "label": "Título principal (deja vacío para usar metafield custom.claim)", "default": "" },
    { "type": "textarea", "id": "hero_subtitle", "label": "Subtítulo", "default": "" },
    { "type": "image_picker", "id": "hero_image", "label": "Imagen hero (deja vacío para usar imagen del producto)" },
    { "type": "text", "id": "atc_label", "label": "Texto del botón", "default": "Añadir al carrito" },
    { "type": "text", "id": "subtext", "label": "Texto bajo el botón (garantía, envío...)", "default": "✓ Envío gratis · ✓ 30 días de garantía" }
  ],
  "blocks": [
    {
      "type": "bullet",
      "name": "Bullet de beneficio",
      "settings": [
        { "type": "text", "id": "text", "label": "Texto", "default": "Beneficio clave del producto" }
      ]
    }
  ],
  "presets": [
    {
      "name": "LP Hero producto",
      "blocks": [
        { "type": "bullet", "settings": { "text": "Resultado visible desde el primer uso" } },
        { "type": "bullet", "settings": { "text": "Sin complicaciones, sin montaje" } },
        { "type": "bullet", "settings": { "text": "Más de 2.000 clientes satisfechos" } }
      ]
    }
  ]
}
{% endschema %}
