<style>
.cmp-table-section {
  padding: 56px 24px;
  background: #FAFAFA;
}
.cmp-table-section__inner {
  max-width: 860px;
  margin: 0 auto;
}
.cmp-table-section__heading {
  font-size: clamp(22px,3vw,32px);
  font-weight: 800;
  color: #111827;
  text-align: center;
  margin: 0 0 32px;
}
.cmp-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 14px;
}
.cmp-table thead th {
  padding: 12px 16px;
  font-size: 13px;
  font-weight: 700;
  text-align: center;
  border-bottom: 2px solid #E5E7EB;
}
.cmp-table thead th.cmp-ours {
  background: #FFF5F0;
  color: #FF5A1F;
  border-radius: 8px 8px 0 0;
}
.cmp-table thead th.cmp-others {
  color: #9CA3AF;
}
.cmp-table tbody td {
  padding: 11px 16px;
  text-align: center;
  border-bottom: 1px solid #F3F4F6;
  color: #374151;
}
.cmp-table tbody td:first-child {
  text-align: left;
  font-weight: 500;
  color: #111827;
}
.cmp-table tbody tr:last-child td { border-bottom: none; }
.cmp-table tbody td.cmp-ours {
  background: #FFF5F0;
  font-weight: 700;
  color: #FF5A1F;
}
.cmp-check { color: #16A34A; font-size: 16px; }
.cmp-cross { color: #D1D5DB; font-size: 16px; }
@media(max-width:580px){
  .cmp-table { font-size: 12px; }
  .cmp-table thead th, .cmp-table tbody td { padding: 9px 10px; }
}
</style>

<section class="cmp-table-section" id="cmp-{{ section.id }}">
  <div class="cmp-table-section__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="cmp-table-section__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <table class="cmp-table" role="table">
      <thead>
        <tr>
          <th scope="col" style="text-align:left;color:#111827">Característica</th>
          <th scope="col" class="cmp-ours">{{ section.settings.col_ours | default: 'Nosotros' }}</th>
          <th scope="col" class="cmp-others">{{ section.settings.col_others | default: 'Alternativas' }}</th>
        </tr>
      </thead>
      <tbody>
        {%- for block in section.blocks -%}
          {%- if block.type == 'row' -%}
            <tr {{ block.shopify_attributes }}>
              <td>{{ block.settings.feature }}</td>
              <td class="cmp-ours">
                {%- if block.settings.ours_icon == 'check' -%}<span class="cmp-check">&#10003;</span>
                {%- elsif block.settings.ours_icon == 'cross' -%}<span class="cmp-cross">&#10005;</span>
                {%- else -%}{{ block.settings.ours_text }}{%- endif -%}
              </td>
              <td>
                {%- if block.settings.others_icon == 'check' -%}<span class="cmp-check">&#10003;</span>
                {%- elsif block.settings.others_icon == 'cross' -%}<span class="cmp-cross">&#10005;</span>
                {%- else -%}{{ block.settings.others_text }}{%- endif -%}
              </td>
            </tr>
          {%- endif -%}
        {%- endfor -%}
      </tbody>
    </table>
  </div>
</section>

{% schema %}
{
  "name": "Tabla Comparativa",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "¿Por qué nosotros?" },
    { "type": "text", "id": "col_ours", "label": "Nombre columna nuestra", "default": "Canvoy" },
    { "type": "text", "id": "col_others", "label": "Nombre columna alternativas", "default": "Alternativas" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Fila comparativa",
      "settings": [
        { "type": "text", "id": "feature", "label": "Característica", "default": "" },
        {
          "type": "select", "id": "ours_icon", "label": "Icono columna nuestra",
          "options": [
            { "value": "check", "label": "Check verde" },
            { "value": "cross", "label": "Cruz gris" },
            { "value": "text", "label": "Texto personalizado" }
          ],
          "default": "check"
        },
        { "type": "text", "id": "ours_text", "label": "Texto columna nuestra (si elegiste texto)" },
        {
          "type": "select", "id": "others_icon", "label": "Icono columna alternativas",
          "options": [
            { "value": "check", "label": "Check verde" },
            { "value": "cross", "label": "Cruz gris" },
            { "value": "text", "label": "Texto personalizado" }
          ],
          "default": "cross"
        },
        { "type": "text", "id": "others_text", "label": "Texto columna alternativas (si elegiste texto)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tabla Comparativa",
      "blocks": [
        { "type": "row", "settings": { "feature": "Plegable y compacto", "ours_icon": "check", "others_icon": "cross" } },
        { "type": "row", "settings": { "feature": "Acero inoxidable 304", "ours_icon": "check", "others_icon": "cross" } },
        { "type": "row", "settings": { "feature": "Diseño antideslizante", "ours_icon": "check", "others_icon": "cross" } },
        { "type": "row", "settings": { "feature": "Garantía 30 días", "ours_icon": "check", "others_icon": "cross" } }
      ]
    }
  ]
}
{% endschema %}
