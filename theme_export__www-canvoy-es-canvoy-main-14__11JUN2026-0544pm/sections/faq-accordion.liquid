{%- assign faq_meta = product.metafields.custom.faq.value -%}

<section class="section faq-accordion">
  <div class="wrap faq-accordion__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="faq-accordion__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="faq-accordion__list">
      {%- comment -%} Prioridad: metafield custom.faq → blocks del customizer {%- endcomment -%}
      {%- if faq_meta != blank -%}
        {%- for item in faq_meta -%}
          <details class="faq-item">
            <summary class="faq-item__question">{{ item.question }}</summary>
            <div class="faq-item__answer">{{ item.answer }}</div>
          </details>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          <details class="faq-item" {{ block.shopify_attributes }}>
            <summary class="faq-item__question">{{ block.settings.question }}</summary>
            <div class="faq-item__answer">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .faq-accordion__inner { max-width: 720px; margin-inline: auto; }
  .faq-accordion__heading { font-size: clamp(1.4rem, 2.5vw, 2rem); font-weight: 800; margin-bottom: 2rem; text-align: center; }
  .faq-accordion__list { display: flex; flex-direction: column; gap: 0.75rem; }
  .faq-item { border: 1px solid rgba(0,0,0,0.1); border-radius: 8px; overflow: hidden; }
  .faq-item__question { cursor: pointer; padding: 1rem 1.25rem; font-weight: 600; font-size: 0.95rem; list-style: none; display: flex; justify-content: space-between; align-items: center; }
  .faq-item__question::-webkit-details-marker { display: none; }
  .faq-item__question::after { content: '+'; font-size: 1.25rem; font-weight: 300; transition: transform 0.2s; }
  .faq-item[open] .faq-item__question::after { transform: rotate(45deg); }
  .faq-item__answer { padding: 0 1.25rem 1rem; font-size: 0.9rem; line-height: 1.6; opacity: 0.75; }
</style>

{% schema %}
{
  "name": "FAQ Acordeón",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Preguntas frecuentes" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Pregunta",
      "settings": [
        { "type": "text", "id": "question", "label": "Pregunta", "default": "¿Cuánto tarda en llegar?" },
        { "type": "textarea", "id": "answer", "label": "Respuesta", "default": "Los pedidos se procesan en 24h y llegan en 3-5 días hábiles." }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Acordeón",
      "blocks": [
        { "type": "item", "settings": { "question": "¿Cuánto tarda en llegar?", "answer": "Los pedidos se procesan en 24h y llegan en 3-5 días hábiles." } },
        { "type": "item", "settings": { "question": "¿Puedo devolver el producto?", "answer": "Sí, tienes 30 días desde la recepción para devolver sin ningún coste." } },
        { "type": "item", "settings": { "question": "¿Cómo sé si es compatible con mi caso?", "answer": "Si tienes dudas escríbenos por chat y te asesoramos sin compromiso." } }
      ]
    }
  ]
}
{% endschema %}
