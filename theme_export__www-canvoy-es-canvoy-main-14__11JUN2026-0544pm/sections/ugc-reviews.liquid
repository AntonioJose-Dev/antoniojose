<section class="section ugc-reviews">
  <div class="wrap">
    <div class="section-head section-head--centered">
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.rating_summary != blank -%}
        <p class="ugc-reviews__rating-summary">{{ section.settings.rating_summary }}</p>
      {%- endif -%}
    </div>

    <div class="ugc-reviews__grid">
      {%- for block in section.blocks -%}
        <div class="ugc-review-card" {{ block.shopify_attributes }}>
          {%- if block.settings.photo != blank -%}
            <img
              src="{{ block.settings.photo | image_url: width: 400 }}"
              alt="Foto de {{ block.settings.name | escape }}"
              width="400" height="400"
              loading="lazy"
              class="ugc-review-card__photo"
            >
          {%- endif -%}
          <div class="ugc-review-card__body">
            <div class="ugc-review-card__stars" aria-label="{{ block.settings.rating }} de 5 estrellas">
              {%- assign stars = block.settings.rating | default: 5 -%}
              {%- for i in (1..5) -%}
                {%- if i <= stars -%}<span aria-hidden="true">★</span>{%- else -%}<span aria-hidden="true" class="star--empty">★</span>{%- endif -%}
              {%- endfor -%}
            </div>
            {%- if block.settings.title != blank -%}
              <strong class="ugc-review-card__title">{{ block.settings.title }}</strong>
            {%- endif -%}
            <p class="ugc-review-card__text">{{ block.settings.text }}</p>
            <p class="ugc-review-card__author">— {{ block.settings.name }}{%- if block.settings.location != blank -%}, {{ block.settings.location }}{%- endif -%}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .ugc-reviews__rating-summary { font-size: 1.1rem; font-weight: 600; margin-top: 0.5rem; opacity: 0.7; }
  .ugc-reviews__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem; margin-top: 2rem; }
  .ugc-review-card { background: var(--color-surface, #f9f9f9); border-radius: 12px; overflow: hidden; }
  .ugc-review-card__photo { width: 100%; aspect-ratio: 1/1; object-fit: cover; }
  .ugc-review-card__body { padding: 1.25rem; }
  .ugc-review-card__stars { color: #f5a623; font-size: 1rem; margin-bottom: 0.4rem; }
  .star--empty { opacity: 0.25; }
  .ugc-review-card__title { display: block; font-weight: 700; margin-bottom: 0.4rem; }
  .ugc-review-card__text { font-size: 0.9rem; line-height: 1.55; margin-bottom: 0.6rem; opacity: 0.8; }
  .ugc-review-card__author { font-size: 0.8rem; opacity: 0.5; margin: 0; }
</style>

{% schema %}
{
  "name": "Reseñas UGC",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Lo que dicen nuestros clientes" },
    { "type": "text", "id": "rating_summary", "label": "Resumen de rating", "default": "⭐ 4.8 / 5 — más de 2.000 reseñas verificadas" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Reseña",
      "settings": [
        { "type": "image_picker", "id": "photo", "label": "Foto del cliente" },
        { "type": "range", "id": "rating", "label": "Valoración", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "title", "label": "Título de la reseña", "default": "¡Funciona de verdad!" },
        { "type": "textarea", "id": "text", "label": "Texto", "default": "Llevo 3 semanas usándolo y el cambio es notable. Super recomendado." },
        { "type": "text", "id": "name", "label": "Nombre", "default": "María G." },
        { "type": "text", "id": "location", "label": "Ciudad/País", "default": "Madrid" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reseñas UGC",
      "blocks": [
        { "type": "review", "settings": { "rating": 5, "title": "Increíble, lo recomiendo", "text": "Nunca pensé que marcaría tanta diferencia. Ya he pedido uno para mi madre.", "name": "Carlos M.", "location": "Valencia" } },
        { "type": "review", "settings": { "rating": 5, "title": "Llegó rápido y funciona", "text": "Dudé al principio pero tras dos semanas de uso ya se nota el cambio.", "name": "Laura P.", "location": "Barcelona" } },
        { "type": "review", "settings": { "rating": 5, "title": "Relación calidad/precio top", "text": "Esperaba algo básico y me sorprendió la calidad. Producto 10.", "name": "Javier R.", "location": "Sevilla" } }
      ]
    }
  ]
}
{% endschema %}
