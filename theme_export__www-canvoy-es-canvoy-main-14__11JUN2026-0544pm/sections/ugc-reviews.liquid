<style>
.ugc-reviews {
  padding: 56px 24px;
  background: #fff;
}
.ugc-reviews__inner {
  max-width: 1100px;
  margin: 0 auto;
}
.ugc-reviews__header {
  text-align: center;
  margin-bottom: 32px;
}
.ugc-reviews__heading {
  font-size: clamp(22px,3vw,32px);
  font-weight: 800;
  color: #111827;
  margin: 0 0 8px;
}
.ugc-reviews__meta {
  font-size: 15px;
  color: #6B7280;
}
.ugc-reviews__meta strong { color: #F59E0B; }
.ugc-reviews__grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(min(280px,100%), 1fr));
  gap: 16px;
}
.ugc-card {
  background: #FAFAFA;
  border-radius: 12px;
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.ugc-card__stars { color: #F59E0B; font-size: 13px; }
.ugc-card__text {
  font-size: 14px;
  color: #374151;
  line-height: 1.6;
  flex: 1;
}
.ugc-card__image {
  border-radius: 8px;
  overflow: hidden;
  aspect-ratio: 4/3;
}
.ugc-card__image img {
  width: 100%; height: 100%; object-fit: cover; display: block;
}
.ugc-card__author {
  font-size: 12px;
  font-weight: 700;
  color: #111827;
}
.ugc-card__date { font-size: 11px; color: #9CA3AF; }
.ugc-card__verified {
  font-size: 11px;
  color: #16A34A;
  font-weight: 600;
}
</style>

<section class="ugc-reviews" id="reviews-{{ section.id }}">
  <div class="ugc-reviews__inner">
    <div class="ugc-reviews__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="ugc-reviews__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.rating_global != blank -%}
        <p class="ugc-reviews__meta">
          <strong>&#9733; {{ section.settings.rating_global }}</strong>
          {%- if section.settings.review_count != blank -%}
            &nbsp;&mdash;&nbsp;{{ section.settings.review_count }}
          {%- endif -%}
        </p>
      {%- endif -%}
    </div>

    <div class="ugc-reviews__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'review' -%}
          <article class="ugc-card" {{ block.shopify_attributes }}>
            <div class="ugc-card__stars">
              {%- for i in (1..block.settings.rating) -%}&#9733;{%- endfor -%}
            </div>
            {%- if block.settings.image != blank -%}
              <div class="ugc-card__image">
                <img src="{{ block.settings.image | image_url: width: 600 }}"
                     alt="Foto reseña {{ block.settings.author }}"
                     width="600" height="450" loading="lazy">
              </div>
            {%- endif -%}
            <p class="ugc-card__text">{{ block.settings.text }}</p>
            <div>
              <div class="ugc-card__author">{{ block.settings.author }}</div>
              {%- if block.settings.date != blank -%}
                <div class="ugc-card__date">{{ block.settings.date }}</div>
              {%- endif -%}
              {%- if block.settings.verified -%}
                <div class="ugc-card__verified">&#10003; Compra verificada</div>
              {%- endif -%}
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "UGC Reseñas",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Lo que dicen nuestros clientes" },
    { "type": "text", "id": "rating_global", "label": "Rating global", "default": "4.9" },
    { "type": "text", "id": "review_count", "label": "Texto número de reseñas", "default": "127 reseñas verificadas" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Reseña",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Foto del cliente (opcional)" },
        {
          "type": "range", "id": "rating", "label": "Puntuación",
          "min": 1, "max": 5, "step": 1, "default": 5
        },
        { "type": "textarea", "id": "text", "label": "Texto de la reseña", "default": "" },
        { "type": "text", "id": "author", "label": "Nombre del cliente", "default": "" },
        { "type": "text", "id": "date", "label": "Fecha", "default": "" },
        { "type": "checkbox", "id": "verified", "label": "Compra verificada", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "UGC Reseñas",
      "blocks": [
        { "type": "review", "settings": { "rating": 5, "text": "Exactamente lo que buscaba para mis perros. Se pliega y cabe en el bolsillo del chaleco.", "author": "María G.", "date": "Mayo 2025", "verified": true } },
        { "type": "review", "settings": { "rating": 5, "text": "Lo usé en una ruta de 3 días. Mis dos perros bebieron sin problema y la comida no se derramó.", "author": "Carlos R.", "date": "Abril 2025", "verified": true } },
        { "type": "review", "settings": { "rating": 5, "text": "Bonito diseño, fácil de limpiar y resistente. 100% recomendable.", "author": "Laura M.", "date": "Junio 2025", "verified": true } }
      ]
    }
  ]
}
{% endschema %}
