<section class="section bundle-selector">
  <div class="wrap">
    {%- if section.settings.heading != blank -%}
      <h2 class="bundle-selector__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="bundle-selector__sub">{{ section.settings.subheading }}</p>
    {%- endif -%}

    <div class="bundle-selector__grid">
      {%- for block in section.blocks -%}
        {%- assign is_featured = block.settings.featured -%}
        <div class="bundle-card{% if is_featured %} bundle-card--featured{% endif %}" {{ block.shopify_attributes }}>
          {%- if is_featured and section.settings.featured_label != blank -%}
            <span class="bundle-card__badge">{{ section.settings.featured_label }}</span>
          {%- endif -%}
          <p class="bundle-card__label">{{ block.settings.label }}</p>
          <div class="bundle-card__price">
            {%- if block.settings.original_price != blank -%}
              <span class="bundle-card__compare">{{ block.settings.original_price }}</span>
            {%- endif -%}
            <span class="bundle-card__current">{{ block.settings.price }}</span>
          </div>
          {%- if block.settings.saving != blank -%}
            <p class="bundle-card__saving">{{ block.settings.saving }}</p>
          {%- endif -%}
          <ul class="bundle-card__contents">
            {%- assign items = block.settings.contents | split: '|' -%}
            {%- for item in items -%}
              {%- if item != blank -%}<li>{{ item | strip }}</li>{%- endif -%}
            {%- endfor -%}
          </ul>
          <a href="{{ block.settings.url | default: product.url }}" class="btn{% if is_featured %} btn--primary{% else %} btn--outline{% endif %} btn--full">
            {{ block.settings.cta | default: 'Seleccionar' }}
          </a>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .bundle-selector__heading { text-align: center; font-size: clamp(1.4rem, 2.5vw, 2rem); font-weight: 800; margin-bottom: 0.5rem; }
  .bundle-selector__sub { text-align: center; opacity: 0.6; margin-bottom: 2rem; }
  .bundle-selector__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.25rem; }
  .bundle-card { position: relative; border: 2px solid rgba(0,0,0,0.1); border-radius: 12px; padding: 1.5rem; display: flex; flex-direction: column; gap: 0.75rem; }
  .bundle-card--featured { border-color: currentColor; box-shadow: 0 4px 20px rgba(0,0,0,0.12); }
  .bundle-card__badge { position: absolute; top: -12px; left: 50%; transform: translateX(-50%); background: currentColor; color: var(--color-bg, #fff); font-size: 0.7rem; font-weight: 800; padding: 0.2rem 0.75rem; border-radius: 99px; white-space: nowrap; }
  .bundle-card__label { font-weight: 700; font-size: 1rem; text-align: center; }
  .bundle-card__price { display: flex; align-items: baseline; gap: 0.5rem; justify-content: center; }
  .bundle-card__compare { text-decoration: line-through; opacity: 0.4; font-size: 0.9rem; }
  .bundle-card__current { font-size: 1.5rem; font-weight: 800; }
  .bundle-card__saving { text-align: center; font-size: 0.8rem; font-weight: 600; color: #27ae60; margin: 0; }
  .bundle-card__contents { list-style: none; padding: 0; font-size: 0.85rem; opacity: 0.7; display: flex; flex-direction: column; gap: 0.25rem; }
  .bundle-card__contents li::before { content: '✓ '; }
  @media (max-width: 600px) { .bundle-selector__grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Bundle / Pack selector",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Elige tu pack" },
    { "type": "text", "id": "subheading", "label": "Subtítulo", "default": "Cuantos más pides, más ahorras" },
    { "type": "text", "id": "featured_label", "label": "Etiqueta del pack destacado", "default": "Más popular" }
  ],
  "blocks": [
    {
      "type": "pack",
      "name": "Pack",
      "settings": [
        { "type": "text", "id": "label", "label": "Nombre del pack", "default": "Pack 1 unidad" },
        { "type": "text", "id": "price", "label": "Precio", "default": "24,99 €" },
        { "type": "text", "id": "original_price", "label": "Precio tachado", "default": "" },
        { "type": "text", "id": "saving", "label": "Texto de ahorro", "default": "" },
        { "type": "textarea", "id": "contents", "label": "Contenido (separa con |)", "default": "1 unidad principal | Manual de uso" },
        { "type": "checkbox", "id": "featured", "label": "Destacar este pack", "default": false },
        { "type": "url", "id": "url", "label": "URL del producto/variante" },
        { "type": "text", "id": "cta", "label": "Texto del botón", "default": "Seleccionar" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bundle / Pack selector",
      "blocks": [
        { "type": "pack", "settings": { "label": "Pack Básico", "price": "24,99 €", "original_price": "", "saving": "", "contents": "1 unidad principal", "featured": false, "cta": "Seleccionar" } },
        { "type": "pack", "settings": { "label": "Pack Familia", "price": "39,99 €", "original_price": "49,98 €", "saving": "Ahorras 10 €", "contents": "2 unidades | Envío prioritario", "featured": true, "cta": "Seleccionar" } },
        { "type": "pack", "settings": { "label": "Pack Premium", "price": "54,99 €", "original_price": "74,97 €", "saving": "Ahorras 20 €", "contents": "3 unidades | Envío prioritario | Regalo sorpresa", "featured": false, "cta": "Seleccionar" } }
      ]
    }
  ]
}
{% endschema %}
