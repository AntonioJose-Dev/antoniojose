<section class="section media-with-copy">
  <div class="wrap media-with-copy__inner media-with-copy__inner--{{ section.settings.image_position }}">

    <div class="media-with-copy__media">
      {%- if section.settings.video_url != blank -%}
        <video
          src="{{ section.settings.video_url }}"
          autoplay loop muted playsinline
          class="media-with-copy__video"
          width="600" height="600"
        ></video>
      {%- elsif section.settings.image != blank -%}
        <img
          src="{{ section.settings.image | image_url: width: 700 }}"
          alt="{{ section.settings.image.alt | escape }}"
          width="700" height="700"
          loading="lazy"
          class="media-with-copy__img"
        >
      {%- endif -%}
    </div>

    <div class="media-with-copy__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="media-with-copy__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="media-with-copy__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <div class="media-with-copy__body rte">{{ section.settings.body }}</div>
      {%- endif -%}
      <ul class="media-with-copy__steps">
        {%- for block in section.blocks -%}
          <li class="media-with-copy__step" {{ block.shopify_attributes }}>
            <span class="step-num">{{ forloop.index }}</span>
            <div>
              <strong>{{ block.settings.title }}</strong>
              <p>{{ block.settings.text }}</p>
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </div>

  </div>
</section>

<style>
  .media-with-copy__inner { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; }
  .media-with-copy__inner--right .media-with-copy__media { order: 2; }
  .media-with-copy__inner--right .media-with-copy__content { order: 1; }
  .media-with-copy__img, .media-with-copy__video { width: 100%; border-radius: 12px; }
  .media-with-copy__eyebrow { font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; opacity: 0.5; margin-bottom: 0.5rem; }
  .media-with-copy__heading { font-size: clamp(1.4rem, 2.5vw, 2rem); font-weight: 800; margin-bottom: 1rem; }
  .media-with-copy__body { margin-bottom: 1.25rem; opacity: 0.75; }
  .media-with-copy__steps { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 1rem; }
  .media-with-copy__step { display: flex; gap: 1rem; align-items: flex-start; }
  .step-num { width: 28px; height: 28px; border-radius: 50%; background: currentColor; color: var(--color-bg, #fff); display: flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: 800; flex-shrink: 0; }
  .media-with-copy__step strong { display: block; font-weight: 700; margin-bottom: 0.2rem; }
  .media-with-copy__step p { margin: 0; font-size: 0.9rem; opacity: 0.7; }
  @media (max-width: 768px) { .media-with-copy__inner { grid-template-columns: 1fr; } .media-with-copy__inner--right .media-with-copy__media { order: 0; } }
</style>

{% schema %}
{
  "name": "Media + Copy",
  "tag": "section",
  "settings": [
    { "type": "select", "id": "image_position", "label": "Posición de la imagen", "options": [ { "value": "left", "label": "Izquierda" }, { "value": "right", "label": "Derecha" } ], "default": "left" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Así funciona" },
    { "type": "richtext", "id": "body", "label": "Cuerpo de texto" },
    { "type": "image_picker", "id": "image", "label": "Imagen" },
    { "type": "text", "id": "video_url", "label": "URL de vídeo (mp4) — tiene prioridad sobre imagen" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Paso",
      "settings": [
        { "type": "text", "id": "title", "label": "Título del paso", "default": "Paso" },
        { "type": "textarea", "id": "text", "label": "Descripción", "default": "Descripción del paso." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Media + Copy",
      "blocks": [
        { "type": "step", "settings": { "title": "Aplica", "text": "Solo necesitas 2 minutos al día." } },
        { "type": "step", "settings": { "title": "Activa", "text": "La tecnología hace el trabajo por ti." } },
        { "type": "step", "settings": { "title": "Resultado", "text": "Visible en 2-4 semanas con uso constante." } }
      ]
    }
  ]
}
{% endschema %}
