<style>
.mwc-section {
  padding: 56px 24px;
  background: var(--mwc-bg, #fff);
}
.mwc-inner {
  max-width: 1100px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 56px;
  align-items: center;
}
.mwc-inner--right { direction: rtl; }
.mwc-inner--right > * { direction: ltr; }
@media(max-width:749px){
  .mwc-inner { grid-template-columns:1fr; gap:28px; }
  .mwc-inner--right { direction: ltr; }
}
.mwc-media { border-radius: 16px; overflow: hidden; }
.mwc-media img { width:100%; display:block; object-fit:cover; aspect-ratio:4/3; }
.mwc-media video { width:100%; display:block; border-radius:16px; }
.mwc-copy__tag {
  font-size: 11px; font-weight: 700; text-transform: uppercase;
  letter-spacing: .08em; color: #FF5A1F; margin-bottom: 10px;
}
.mwc-copy__heading {
  font-size: clamp(22px,3vw,34px);
  font-weight: 800; color: #111827;
  line-height: 1.2; margin: 0 0 14px;
}
.mwc-copy__body {
  font-size: 15px; color: #4B5563; line-height: 1.7; margin: 0 0 20px;
}
.mwc-steps { list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:14px; }
.mwc-step {
  display:flex; align-items:flex-start; gap:14px;
}
.mwc-step__num {
  width:32px; height:32px; flex-shrink:0;
  background:#FF5A1F; color:#fff;
  border-radius:50%; display:flex;
  align-items:center; justify-content:center;
  font-size:13px; font-weight:800;
}
.mwc-step__text { font-size:14px; color:#374151; line-height:1.5; padding-top:6px; }
</style>

<section class="mwc-section" id="mwc-{{ section.id }}">
  <div class="mwc-inner{% if section.settings.layout == 'image_right' %} mwc-inner--right{% endif %}">

    <div class="mwc-media">
      {%- if section.settings.video != blank -%}
        <video src="{{ section.settings.video }}" autoplay muted loop playsinline></video>
      {%- elsif section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 800 }}"
             alt="{{ section.settings.heading | escape }}"
             width="800" height="600" loading="lazy">
      {%- else -%}
        <div style="aspect-ratio:4/3;background:#f3f4f6;border-radius:16px;"></div>
      {%- endif -%}
    </div>

    <div class="mwc-copy">
      {%- if section.settings.tag != blank -%}
        <p class="mwc-copy__tag">{{ section.settings.tag }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="mwc-copy__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <div class="mwc-copy__body">{{ section.settings.body }}</div>
      {%- endif -%}

      {%- assign has_steps = false -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'step' -%}{%- assign has_steps = true -%}{%- endif -%}
      {%- endfor -%}

      {%- if has_steps -%}
        <ol class="mwc-steps">
          {%- assign step_num = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'step' -%}
              {%- assign step_num = step_num | plus: 1 -%}
              <li class="mwc-step" {{ block.shopify_attributes }}>
                <span class="mwc-step__num">{{ step_num }}</span>
                <span class="mwc-step__text">{{ block.settings.text }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ol>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Media con Copy",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen" },
    { "type": "url", "id": "video", "label": "URL vídeo (opcional, sobreescribe imagen)" },
    { "type": "text", "id": "tag", "label": "Tag superior", "default": "Cómo funciona" },
    { "type": "text", "id": "heading", "label": "Título", "default": "" },
    { "type": "richtext", "id": "body", "label": "Cuerpo de texto" },
    {
      "type": "select", "id": "layout", "label": "Posición imagen",
      "options": [
        { "value": "image_left", "label": "Imagen a la izquierda" },
        { "value": "image_right", "label": "Imagen a la derecha" }
      ],
      "default": "image_left"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Paso",
      "settings": [
        { "type": "text", "id": "text", "label": "Texto del paso", "default": "" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Media con Copy",
      "blocks": [
        { "type": "step", "settings": { "text": "Abre el bowl y colócalo en el suelo" } },
        { "type": "step", "settings": { "text": "Llena con agua o comida directamente" } },
        { "type": "step", "settings": { "text": "Recoge, pliega y guarda en el bolsillo" } }
      ]
    }
  ]
}
{% endschema %}
